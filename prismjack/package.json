{
  "name": "le-casse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prismjack — jeu de déduction : retrouve les joyaux cachés en testant la salle au laser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run check && npm run test && npm run build",
    "cap:sync": "npm run build && cap sync",
    "build:portfolio": "vite build --outDir dist-portfolio/prismjack --emptyOutDir"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.0.0",
    "typescript": ">=5.8 <6.1",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/nunito": "^5.3.0"
  }
}
